/*
 * Reenvio del trackball desde la mitad derecha (periferica) a la izquierda
 * (central). Ambos firmwares deben conocer el mismo zmk,input-split.
 */
#include <input/processors.dtsi>

/ {
    behaviors {
        pmwcpi: pmwcpi {
            compatible = "zmk,behavior-pmw-cpi";
            #binding-cells = <2>;
        };
    };

    input_processors {
        pmw_temp_layer: pmw_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <200>;
        };
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
        input-processors = <&pmw_temp_layer 4 1000>;
    };
};
